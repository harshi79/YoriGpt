# Copy to .env for local development. No live database is needed to generate/build.
# Run npm run db:generate after install and schema changes (see docs/database.md).
# All variables are server-only. Never prefix secrets with NEXT_PUBLIC_.
APP_URL=http://localhost:3000

# A syntactically valid URL is used by Prisma CLI validation/generation, without connecting.
# Real connection details are required only for migration commands / runtime DB queries.
# Replace placeholders before those operations; this is NOT a working database account.
# Use a direct, unpooled URL with schema-owner rights for migrations.
# Runtime URLs should use a least-privilege role and verified TLS in production.
DATABASE_URL=postgresql://replace_me:replace_me@localhost:5432/yorigpt?schema=public

# Better Auth: generate a random value, e.g. openssl rand -base64 32. Server-only.
# Sessions fail to start without it (min 32 characters); never expose it to the browser.
AUTH_SECRET=

# Comma-separated extra browser origins allowed to call the auth API (deployed
# preview/alias hosts). APP_URL's own origin is always trusted. Defaults to none.
AUTH_TRUSTED_ORIGINS=

# Transactional email for verification and password-reset links. Optional: without
# both values, accounts and sessions still work and the auth pages say that email
# is not configured yet. URL-encode credentials in the URL.
# Example format: smtps://USERNAME:PASSWORD@SMTP_HOST:465
SMTP_URL=
EMAIL_FROM=noreply@example.com

# OpenRouter assistant replies, streamed to the browser as server-sent events. The
# keys are server-only and must never appear in a client component, NEXT_PUBLIC_
# variable, log line, serialized prop, or error message. A comma-separated list is
# accepted; whitespace is trimmed and blank entries are ignored. One key is enough.
# With several, the adapter rotates through them: keys are used in round-robin order,
# a key the provider rejects (401/403) or rate limits (429) is skipped for 30 seconds,
# and a request that fails before any answer text is delivered may be retried with the
# next key — at most three keys per request, never the same key twice. Secrets,
# cooldowns, and rotation state live in server memory only; nothing is stored in the
# database and nothing is exposed to the browser. Without a usable key, sending a
# message still stores it and the UI reports that replies are not configured. There is
# no separate setting for streaming: the same keys, base URL, and model are used, with
# a 30-second overall deadline (shared by every attempt) and caps on the streamed size
# and the stored reply text (see src/server/ai/providers/openrouter.ts).
OPENROUTER_API_KEYS=
# Official OpenAI-compatible endpoint; override only for a compatible gateway.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional. Names the DEFAULT model only, and only when it matches an active entry in
# the server-owned catalog (src/server/ai/models/catalog.ts) - by OpenRouter identifier
# (openai/gpt-4o) or by catalog key (gpt-4o). Any other value is ignored (with a
# one-time warning) and the catalog default, gpt-4o-mini, is used, so a model the
# selector cannot show can never be selected behind the user's back. A saved user
# preference always wins over this setting. Selecting a model in the UI stores that
# account's preference; the browser only ever sends a catalog key.
OPENROUTER_MODEL=

# Reserved: no NVIDIA/NIM provider is implemented.
NVIDIA_API_KEYS=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional read-only database integration tests: supply a migrated disposable database.
# Never defaults to DATABASE_URL; leave blank unless explicitly running npm run test:db.
DATABASE_TEST_URL=
